# Konfiguration per Environment. Ohne Keys läuft das System vollständig offline
# (Template-LLM, stiller Voiceover-Bett, PIL-Visuals, Dry-Run-Publishing).
# Sobald ein Key gesetzt ist, wird automatisch der echte Dienst genutzt.

# --- LLM (Themenanalyse, Skript, Captions) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Voiceover (TTS) ---
# ELEVENLABS_API_KEY=
# (OpenAI-Key aktiviert alternativ OpenAI-TTS)

# --- Link-Ingestion (YouTube -> Transkript) ---
# yt-dlp lädt die Audiospur; Transkription via OpenAI Whisper API (OPENAI_API_KEY)
# oder lokal via faster-whisper (pip install faster-whisper).
# WHISPER_MODEL=base

# --- TikTok Publishing (Login Kit + Content Posting API) ---
# PUBLISH_MODE=dry_run              # dry_run | draft | direct_post
# TIKTOK_CLIENT_KEY=                # aus dem TikTok Developer Portal
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://deine-app/callback
# TIKTOK_ACCESS_TOKEN=             # via `tiktok-exchange` erhalten
# TIKTOK_REFRESH_TOKEN=            # optional; Access-Token wird dann autom. erneuert
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY   # SELF_ONLY | PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR
